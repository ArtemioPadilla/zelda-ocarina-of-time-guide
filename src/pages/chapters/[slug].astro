---
import GameChapterPage from '@/components/game/GameChapterPage.astro';
import { gameChapters, chapterSlug } from '@/lib/game-content';
import { GAME_ID } from '@/lib/games';

export async function getStaticPaths() {
  const chapters = await gameChapters(GAME_ID, 'es');
  return chapters.map((entry) => ({ params: { slug: chapterSlug(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
---

<GameChapterPage locale="es" game={GAME_ID} entry={entry} />
