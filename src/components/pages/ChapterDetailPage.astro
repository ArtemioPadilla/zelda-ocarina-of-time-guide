---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ErrorBoundary from '@/components/islands/ErrorBoundary';
import SetCurrentChapterButton from '@/components/islands/SetCurrentChapterButton';
import { useTranslations, localizedHref } from '@/i18n/utils';
import { getLocalized } from '@/lib/content';
import { PILL_STYLE, type PillType } from '@/lib/pills';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'chapters_es'> | CollectionEntry<'chapters_en'>;
}
const { locale, entry } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);

// A dungeon is read sequentially during a playthrough — offer prev/next so
// finishing one doesn't require a trip back to the index every time.
const allChapters = (await getLocalized('chapters', locale)).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allChapters.findIndex((c) => c.id === entry.id);
const prevChapter = currentIndex > 0 ? allChapters[currentIndex - 1] : null;
const nextChapter = currentIndex >= 0 && currentIndex < allChapters.length - 1 ? allChapters[currentIndex + 1] : null;
---
<BaseLayout title={`${entry.data.number} · ${entry.data.title} · ${t('site.name')}`} lang={locale}>
  <main id="main" class="mx-auto max-w-3xl px-5 py-14">
    <a href={localizedHref(locale, '/chapters/')} class="mb-6 inline-block font-mono text-xs text-muted-foreground hover:text-primary">
      {t('chapter.back')}
    </a>

    <div class="mb-2 flex flex-wrap items-center gap-3">
      <span class="font-display text-2xl font-bold text-primary">{entry.data.number}</span>
      <h1 class="font-display text-2xl font-semibold text-foreground">{entry.data.title}</h1>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-2">
      {entry.data.pills.map((p: { type: PillType; label: string }) => (
        <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[11px] ${PILL_STYLE[p.type]}`}>{p.label}</span>
      ))}
      <span class="ml-auto">
        <ErrorBoundary client:load name="SetCurrentChapterButton" messageLabel={t('a11y.errorBoundaryMessage')} reportLabel={t('a11y.errorBoundaryReport')}>
          <SetCurrentChapterButton
            client:load
            chapterId={entry.id}
            label={t('chapter.markCurrent')}
            currentLabel={t('chapter.isCurrent')}
          />
        </ErrorBoundary>
      </span>
    </div>

    <article class="prose-guide max-w-none">
      <Content />
    </article>

    <nav aria-label={t('chapter.prevNextLabel')} class="mt-10 flex items-center gap-3 border-t border-border pt-6">
      {prevChapter ? (
        <a href={localizedHref(locale, `/chapters/${prevChapter.id}/`)} class="panel min-w-0 flex-1 p-3 text-sm">
          <span class="block font-mono text-[10px] uppercase tracking-wide text-muted-foreground">{t('chapter.prev')}</span>
          <span class="block truncate text-foreground">{prevChapter.data.number} · {prevChapter.data.title}</span>
        </a>
      ) : <span class="flex-1"></span>}
      {nextChapter ? (
        <a href={localizedHref(locale, `/chapters/${nextChapter.id}/`)} class="panel min-w-0 flex-1 p-3 text-right text-sm">
          <span class="block font-mono text-[10px] uppercase tracking-wide text-muted-foreground">{t('chapter.next')}</span>
          <span class="block truncate text-foreground">{nextChapter.data.number} · {nextChapter.data.title}</span>
        </a>
      ) : <span class="flex-1"></span>}
    </nav>
  </main>
</BaseLayout>
