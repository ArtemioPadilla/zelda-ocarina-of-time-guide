---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from '@/components/islands/SearchBox';
import { useTranslations, localizedHref, swapLocaleHref } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import type { NavLink } from '@/lib/nav';

interface Props {
  locale: Locale;
  /** The game's sections (only those with content). */
  nav: NavLink[];
  searchHref: string;
}
const { locale, nav, searchHref } = Astro.props;
const t = useTranslations(locale);

// Language switcher: same route, other locale — route segments are always
// English regardless of locale (see swapLocaleHref), only the /en/ prefix
// and UI copy change.
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const switchHref = swapLocaleHref(otherLocale, Astro.url.pathname);
---

<header class="z-40 border-b border-border/70 bg-background/85 backdrop-blur-md md:sticky md:top-0">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-5 pt-2.5">
    <a
      href={localizedHref(locale, '/')}
      class="flex items-center gap-2.5 whitespace-nowrap font-display text-lg font-bold tracking-tight text-foreground"
    >
      <span class="brand-mark" aria-hidden="true"></span>
      {t('site.name')}
    </a>
    <div class="ml-auto flex items-center gap-2">
      <SearchBox
        client:load
        indexHref={searchHref}
        labels={{
          open: t('search.open'),
          placeholder: t('search.placeholder'),
          empty: t('search.empty'),
          hint: t('search.hint'),
          close: t('search.close'),
        }}
      />
      <a
        href={switchHref}
        class="rounded-md border border-border/70 px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
        hreflang={otherLocale}
      >
        {otherLocale.toUpperCase()}
      </a>
      <ThemeToggle locale={locale} />
    </div>
  </div>
  <nav
    class="mx-auto flex max-w-6xl items-center overflow-x-auto px-5 pb-1 pt-1.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    style="mask-image: linear-gradient(to right, black calc(100% - 24px), transparent); -webkit-mask-image: linear-gradient(to right, black calc(100% - 24px), transparent);"
    aria-label={locale === 'es' ? 'Secciones de la guía' : 'Guide sections'}
  >
    {
      nav.map((n) => (
        <a href={n.href} aria-current={n.active ? 'page' : undefined} class="nav-tab">
          {n.label}
        </a>
      ))
    }
  </nav>
</header>
