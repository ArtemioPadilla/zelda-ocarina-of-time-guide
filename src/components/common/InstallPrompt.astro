---
/**
 * InstallPrompt — invites the reader to install the guide as an app (PWA).
 *
 * - Chrome/Edge/Android: waits for `beforeinstallprompt`, then the button
 *   opens the browser's own install dialog.
 * - iPhone/iPad (no install event): the banner explains Share → "Add to
 *   Home Screen" instead of showing a button; other browsers without the
 *   event get the browser-menu instructions when opened from the footer.
 * - Never shown inside the installed app, and "Not now" keeps it away for
 *   two weeks (per browser; storage errors just mean it may show again).
 * The footer link (`[data-install-open]`) brings it back on demand.
 */
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="install-prompt"
  hidden
  role="dialog"
  aria-labelledby="install-prompt-title"
  class="fixed inset-x-4 bottom-[calc(72px+env(safe-area-inset-bottom))] z-50 mx-auto max-w-md rounded-lg border border-primary/50 bg-card p-4 shadow-lg md:bottom-6"
>
  <p id="install-prompt-title" class="font-display text-base font-semibold text-foreground">
    {t('install.title')}
  </p>
  <p class="mt-1 text-sm text-muted-foreground">{t('install.body')}</p>
  <p data-install-ios hidden class="mt-2 text-sm text-foreground">{t('install.ios')}</p>
  <p data-install-manual hidden class="mt-2 text-sm text-foreground">{t('install.manual')}</p>
  <div class="mt-3 flex justify-end gap-2">
    <button
      type="button"
      data-install-later
      class="rounded-md px-3 py-1.5 font-mono text-xs text-muted-foreground hover:text-foreground"
    >
      {t('install.later')}
    </button>
    <button
      type="button"
      data-install-go
      hidden
      class="rounded-md bg-primary px-3 py-1.5 font-mono text-xs font-semibold text-primary-foreground"
    >
      {t('install.button')}
    </button>
  </div>
</div>

<script>
  type InstallEvent = Event & { prompt: () => Promise<void>; userChoice: Promise<unknown> };

  const KEY = 'oot-install-dismissed';
  const QUIET_MS = 14 * 24 * 60 * 60 * 1000;
  const box = document.getElementById('install-prompt');
  const goBtn = box?.querySelector<HTMLButtonElement>('[data-install-go]');
  const iosNote = box?.querySelector<HTMLElement>('[data-install-ios]');
  const manualNote = box?.querySelector<HTMLElement>('[data-install-manual]');
  let deferred: InstallEvent | null = null;

  const installed = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;
  const ios =
    /iphone|ipad|ipod/i.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const quiet = () => {
    try {
      return Date.now() - Number(localStorage.getItem(KEY) ?? 0) < QUIET_MS;
    } catch {
      return false;
    }
  };
  const show = () => {
    if (!box || installed()) return;
    if (goBtn) goBtn.hidden = !deferred;
    if (iosNote) iosNote.hidden = !(ios && !deferred);
    if (manualNote) manualNote.hidden = ios || !!deferred;
    box.hidden = false;
  };
  const hide = (remember: boolean) => {
    if (box) box.hidden = true;
    if (!remember) return;
    try {
      localStorage.setItem(KEY, String(Date.now()));
    } catch {
      /* storage blocked: the banner may come back next visit */
    }
  };

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferred = e as InstallEvent;
    if (!quiet()) show();
  });
  window.addEventListener('appinstalled', () => hide(true));
  if (ios && !installed() && !quiet()) setTimeout(show, 2500);

  goBtn?.addEventListener('click', async () => {
    if (!deferred) return;
    await deferred.prompt();
    await deferred.userChoice;
    deferred = null;
    hide(true);
  });
  box?.querySelector('[data-install-later]')?.addEventListener('click', () => hide(true));
  document.querySelectorAll('[data-install-open]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      show();
    }),
  );
  if (installed())
    document
      .querySelectorAll<HTMLElement>('[data-install-open]')
      .forEach((el) => (el.hidden = true));
</script>
